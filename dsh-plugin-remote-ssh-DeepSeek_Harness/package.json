{
  "name": "dsh-plugin-remote-ssh",
  "version": "1.0.0",
  "description": "Cursor-like Remote SSH plugin for DeepSeek Harness Desktop (0.2.0-rc.2)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kexiq-droid/dsh-plugin-remote-ssh-DeepSeek_Harness.git"
  },
  "main": "./dist/host.cjs",
  "exports": {
    ".": {
      "import": "./dist/host.mjs",
      "require": "./dist/host.cjs"
    },
    "./client": {
      "import": "./dist/client.mjs",
      "require": "./dist/client.cjs"
    }
  },
  "dsh": {
    "id": "remote-ssh",
    "displayName": "Remote SSH (Cursor Style)",
    "version": "1.0.0",
    "engines": {
      "dsh": ">=0.2.0-rc.0 <0.3.0"
    },
    "host": "./dist/host.cjs",
    "client": "./dist/client.mjs",
    "permissions": [
      "fs",
      "subprocess",
      "workspace",
      "shell.bottom",
      "network"
    ]
  },
  "cordis": {
    "name": "remote-ssh",
    "Main": "./dist/host.cjs",
    "Client": "./dist/client.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "COMPATIBILITY.md",
    "package.json"
  ],
  "scripts": {
    "verify:env": "node scripts/verify-env.mjs",
    "build": "tsup",
    "test": "vitest run",
    "pack:plugin": "npm run build && npm pack"
  },
  "dependencies": {
    "ssh-config": "^4.4.0",
    "ssh2": "^1.15.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/ssh2": "^1.15.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  }
}